NODE_ENV=development
API_PORT=4000
# Python analytics service (analytics-service/app.py)
ANALYTICS_SERVICE_URL=http://localhost:5001
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=8h
# false = requests without a token act as the demo user (handy while the frontend has no login screen)
AUTH_REQUIRED=false
# No database yet: users, chats, settings and AI logs live in memory and reset on restart.
# MONGODB_URI=mongodb://localhost:27017/ecommercelens   (Phase 4)
